@@ -66,0 +67,29 @@ const SAMPLE_COUNTERS_LOG_PERIOD: Duration = Duration::from_secs(2);
+#[derive(Default)]
+struct PmcDeltaTracker {
+    previous: HashMap<u32, Vec<u64>>,
+    rebases: u64,
+}
+
+impl PmcDeltaTracker {
+    fn observe(&mut self, tid: u32, snapshot: &[u64]) -> Vec<u64> {
+        if snapshot.is_empty() {
+            return Vec::new();
+        }
+        if snapshot.iter().all(|&value| value == 0) {
+            self.previous.remove(&tid);
+            self.rebases += 1;
+            return vec![0; snapshot.len()];
+        }
+        let previous = self.previous.insert(tid, snapshot.to_vec());
+        if let Some(previous) = previous {
+            if previous.len() == snapshot.len()
+                && snapshot.iter().zip(&previous).all(|(current, old)| current >= old)
+            {
+                return snapshot.iter().zip(previous).map(|(current, old)| current - old).collect();
+            }
+        }
+        self.rebases += 1;
+        vec![0; snapshot.len()]
+    }
+}
