+#[cfg(test)]
+mod cpu_identity_tests {
+    use super::*;
+
+    #[test]
+    fn saved_pet_samples_keep_cpu_identity_across_reopen() {
+        let mut aggregator = Aggregator::default();
+        aggregator.record_pet_sample_on_cpu(42, 100, &[0x1234], &[], PmuSample::default(), Some(4));
+        aggregator.record_pet_sample(42, 200, &[0x5678], &[], PmuSample::default());
+
+        let saved = aggregator.to_saved();
+        assert_eq!(saved.threads[0].pet_samples[0].cpu, Some(4));
+        assert_eq!(saved.threads[0].pet_samples[1].cpu, None);
+
+        let mut reopened = Aggregator::default();
+        reopened.replace_from_saved(saved);
+        let reopened_samples: Vec<_> = reopened.iter_pet_samples(Some(42)).collect();
+        assert_eq!(reopened_samples[0].1.cpu, Some(4));
+        assert_eq!(reopened_samples[1].1.cpu, None);
+    }
+}
