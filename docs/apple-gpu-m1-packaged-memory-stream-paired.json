  "launcher_source": "import subprocess\nimport sys\nimport time\nfrom pathlib import Path\n\nbinary = Path(sys.argv[1])\noutput = Path(sys.argv[2])\norder = sys.argv[3:]\ntime.sleep(0.4)\nfor mode in order:\n    child = subprocess.Popen([str(binary), '8', '--mode', mode, '--items', '16777216',\n                              '--result', str(output / f'{mode}.json')],\n                             stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)\n    stdout, stderr = child.communicate(timeout=30)\n    print(f'probe_pid={child.pid} mode={mode}', flush=True)\n    print(stdout, end='', flush=True)\n    if child.returncode or 'checksum_verified=true' not in stdout:\n        print(stderr, flush=True)\n        raise SystemExit(f'{mode} probe failed')\n    time.sleep(0.25)\ntime.sleep(1)\n",
