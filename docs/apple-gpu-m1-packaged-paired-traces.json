  "per_pass_analysis": {
    "method": "For each labeled pass window and counter interval, weight the native metric value by nanosecond overlap; then summarize the resulting sampled pass means. These are unfiltered device-wide counter samples and may include observed other activity. Unsampled passes are excluded.",
    "source_sha256": "00cdf6d7d36fa93c679d71473edadc6234e80e145c5dee2453e6a1b90c29478f",
    "source": "import json\nimport math\nfrom pathlib import Path\nimport re\nimport statistics\nimport sys\nsys.path.insert(0,'examples/apple_gpu')\nfrom summarize_counters import _table,_process_pid,PACKAGED_PROBE_LABEL,_merge,_overlap\nroot=Path('/private/tmp/topdown-m1-packaged-pairs-retry-20261023')\nresult={}\nfor profile in (3,4):\n for order in ('compute-first','alu-first'):\n  folder=root/f'profile-{profile}-{order}'\n  pid_mode={json.load(open(folder/f'{mode}-summary.json'))['probe_coverage']['selected_pid']:mode for mode in ('compute','alu')}\n  windows={}\n  for columns,row in _table(folder/'gpu-intervals.xml','metal-gpu-intervals'):\n   label=row[columns.index('event-label')].fmt or row[columns.index('event-label')].text or ''\n   match=PACKAGED_PROBE_LABEL.match(label)\n   if not match:continue\n   pid=_process_pid(row[columns.index('process')])\n   if pid not in pid_mode:continue\n   mode,index=match.group(1),int(match.group(2))\n   if mode!=pid_mode[pid]:raise ValueError('mode-PID mismatch')\n   start=int(row[columns.index('start')].text);duration=int(row[columns.index('duration')].text)\n   windows.setdefault((mode,index),[]).append((start,start+duration))\n  windows={key:_merge(value) for key,value in windows.items()}\n  metrics=['ALU Limiter','F32 Utilization'] if profile==3 else ['F32 Utilization']\n  totals={key:{name:[0.,0] for name in metrics} for key in windows}\n  for columns,row in _table(folder/'counters.xml','metal-gpu-counter-intervals'):\n   name_cell=row[columns.index('name')];name=name_cell.fmt or name_cell.text\n   if name not in metrics:continue\n   start=int(row[columns.index('start')].text);end=start+int(row[columns.index('duration')].text)\n   value=float(row[columns.index('value')].text)\n   for key,pieces in windows.items():\n    overlap=_overlap(start,end,pieces)\n    if overlap:\n     totals[key][name][0]+=overlap*value;totals[key][name][1]+=overlap\n  report={}\n  for mode in ('compute','alu'):\n   report[mode]={}\n   for name in metrics:\n    samples=[totals[(mode,index)][name][0]/totals[(mode,index)][name][1]\n             for index in range(100) if (mode,index) in totals and totals[(mode,index)][name][1]]\n    samples.sort();report[mode][name]={'sampled_passes':len(samples),'min':samples[0],\n     'p10':samples[int(.1*(len(samples)-1))],'median':statistics.median(samples),\n     'p90':samples[int(.9*(len(samples)-1))],'max':samples[-1]}\n  result[f'{profile}-{order}']=report\nprint(json.dumps(result,indent=2))\n",
